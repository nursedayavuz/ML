# Gerekli Kütüphaneler
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from sklearn.preprocessing import StandardScaler
from sklearn.cluster import KMeans
from sklearn.decomposition import PCA
from sklearn.metrics import silhouette_score

# ---------------------------------------------------------
# GÖREV 1.1: Veri Yükleme ve Ön İnceleme
# ---------------------------------------------------------
# Veriyi yükle
df_customer = pd.read_csv('Customer Data.csv')

print("Veri Seti Boyutu:", df_customer.shape)
print("\nİlk 5 Satır:")
print(df_customer.head())

# İstatistiksel özet
print("\nİstatistiksel Özet:")
print(df_customer.describe())

# ---------------------------------------------------------
# GÖREV 1.2: Veri Ön İşleme
# ---------------------------------------------------------
# Eksik verileri kontrol etme
print("\nEksik Değerler:\n", df_customer.isnull().sum())

# Eksik verileri ortalama ile doldurma (MINIMUM_PAYMENTS ve CREDIT_LIMIT genelde eksiktir)
df_customer['MINIMUM_PAYMENTS'].fillna(df_customer['MINIMUM_PAYMENTS'].mean(), inplace=True)
df_customer['CREDIT_LIMIT'].fillna(df_customer['CREDIT_LIMIT'].mean(), inplace=True)

# CUST_ID sütunu model için gereksizdir (string ifade), çıkarıyoruz
df_model_data = df_customer.drop('CUST_ID', axis=1)

# Veriyi Ölçeklendirme (StandardScaler)
scaler = StandardScaler()
df_scaled = scaler.fit_transform(df_model_data)

# Ölçeklenmiş veriyi DataFrame'e çevirelim (kolay kullanım için)
df_scaled = pd.DataFrame(df_scaled, columns=df_model_data.columns)

# ---------------------------------------------------------
# GÖREV 1.3: Optimal Küme Sayısını Belirleme (Elbow & Silhouette)
# ---------------------------------------------------------
inertia = []
silhouette_scores = []
K_range = range(1, 11)

for k in K_range:
    kmeans = KMeans(n_clusters=k, random_state=42)
    kmeans.fit(df_scaled)
    inertia.append(kmeans.inertia_)
    
    # Silhouette skoru en az 2 küme gerektirir
    if k > 1:
        score = silhouette_score(df_scaled, kmeans.labels_)
        silhouette_scores.append(score)

# Elbow Grafiği
plt.figure(figsize=(12, 5))
plt.subplot(1, 2, 1)
plt.plot(K_range, inertia, 'bx-')
plt.xlabel('k (Küme Sayısı)')
plt.ylabel('Inertia (WCSS)')
plt.title('Elbow Yöntemi ile Optimal k')

# Silhouette Grafiği
plt.subplot(1, 2, 2)
plt.plot(range(2, 11), silhouette_scores, 'rx-')
plt.xlabel('k (Küme Sayısı)')
plt.ylabel('Silhouette Skoru')
plt.title('Silhouette Skorları')
plt.show()

# ---------------------------------------------------------
# GÖREV 1.4: K-Means Uygulaması ve Görselleştirme (PCA)
# ---------------------------------------------------------
# Grafiğe bakarak optimal k seçimi (Örneğin k=4 seçelim, grafiğe göre değiştirebilirsin)
optimal_k = 4 
kmeans_final = KMeans(n_clusters=optimal_k, random_state=42)
clusters = kmeans_final.fit_predict(df_scaled)

# Kümeleri ana veriye ekle
df_customer['Cluster'] = clusters

# PCA ile 2 boyuta indirgeme (Görselleştirme için)
pca = PCA(n_components=2)
principal_components = pca.fit_transform(df_scaled)
df_pca = pd.DataFrame(data=principal_components, columns=['PC1', 'PC2'])
df_pca['Cluster'] = clusters

# Scatter Plot
plt.figure(figsize=(10, 7))
sns.scatterplot(x='PC1', y='PC2', hue='Cluster', data=df_pca, palette='viridis', s=100)
plt.title('Müşteri Segmentleri (PCA Görselleştirme)')
plt.show()

# Küme Ortalamalarını Gösterme (Yorumlama için)
print("\nKüme Ortalamaları:")
print(df_customer.groupby('Cluster').mean()) 